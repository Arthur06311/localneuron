{
  "name": "localneuron",
  "version": "0.28.1",
  "private": true,
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/tests/*.test.js tests/*.test.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "site": "node scripts/build-website.mjs",
    "desktop": "electron desktop/main.cjs",
    "package": "npm run build && node scripts/package-desktop.mjs",
    "billing": "node dist/src/billing-service.js",
    "test:linux-installer": "python3 tests/linux_installer_test.py && python3 tests/linux_gui_installer_test.py"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@fastify/rate-limit": "10.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cheerio": "1.2.0",
    "docx": "9.7.1",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "marked": "18.0.12",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "4.0.1",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "25.5.0",
    "electron": "44.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "author": "LocalNeuron",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
