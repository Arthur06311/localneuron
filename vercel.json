{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "billing/static",
  "regions": ["gru1"],
  "rewrites": [
    { "source": "/health", "destination": "/api/billing?path=/health" },
    { "source": "/billing/:path*", "destination": "/api/billing?path=/billing/:path*" }
  ]
}
